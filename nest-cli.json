{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "modules/knowledge/infrastructure/seed/crops/*/*.json",
        "watchAssets": true
      },
      {
        "include": "modules/knowledge/infrastructure/seed/crops/*/articles/*.md",
        "watchAssets": true
      },
      {
        "include": "modules/knowledge/infrastructure/seed/crops/*/articles/images/**/*.webp",
        "watchAssets": true
      }
    ],
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "classValidatorShim": true,
          "introspectComments": false,
          "dtoFileNameSuffix": [
            ".dto.ts",
            ".response.ts"
          ],
          "controllerFileNameSuffix": [
            ".controller.ts"
          ]
        }
      }
    ]
  }
}
