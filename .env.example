# app
NODE_ENV=development
PORT=3000

# database (values match docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=agri-media
DB_NAME=agri-media
DB_LOGGING=false

# logger (production writes JSON to LOG_FILE_PATH; other envs pretty-print to terminal)
LOG_LEVEL=info
LOG_FILE_PATH=logs/app.log
